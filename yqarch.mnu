     [ 2.5 mm](progn (setq YQ_T_HEIGHT 2.5)(setvar "TEXTSIZE" (* (getvar "dimscale") 2.5)))
     [ 3   mm](progn (setq YQ_T_HEIGHT 3.0)(setvar "TEXTSIZE" (* (getvar "dimscale") 3.0)))
     [ 3.5 mm](progn (setq YQ_T_HEIGHT 3.5)(setvar "TEXTSIZE" (* (getvar "dimscale") 3.5)))
     [ 4   mm](progn (setq YQ_T_HEIGHT 4.0)(setvar "TEXTSIZE" (* (getvar "dimscale") 4.0)))
     [ 5   mm](progn (setq YQ_T_HEIGHT 5.0)(setvar "TEXTSIZE" (* (getvar "dimscale") 5.0)))
     [ 6   mm](progn (setq YQ_T_HEIGHT 6.0)(setvar "TEXTSIZE" (* (getvar "dimscale") 6.0)))
     [ 8   mm](progn (setq YQ_T_HEIGHT 8.0)(setvar "TEXTSIZE" (* (getvar "dimscale") 8.0)))
     [10   mm](progn (setq YQ_T_HEIGHT 10.0)(setvar "TEXTSIZE" (* (getvar "dimscale") 10.0)))
     [12   mm](progn (setq YQ_T_HEIGHT 12.0)(setvar "TEXTSIZE" (* (getvar "dimscale") 12.0)))
     [15   mm](progn (setq YQ_T_HEIGHT 15.0)(setvar "TEXTSIZE" (* (getvar "dimscale") 15.0)))
     [20   mm](progn (setq YQ_T_HEIGHT 20.0)(setvar "TEXTSIZE" (* (getvar "dimscale") 20.0)))
